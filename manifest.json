{
  "manifest_version": 3,
  "name": "网页学英语 - 边用边学",
  "version": "1.0.1",
  "description": "浏览中文网页时，把部分中文词替换为英文，边用边学。支持难度分级、替换比例、自定义词表、悬停查看原词。",
  "permissions": ["storage", "unlimitedStorage"],
  "host_permissions": ["https://fanyi-api.baidu.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["lib/dict-core.js", "lib/matcher.js", "content/content.js"],
      "css": ["content/content.css"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "options_page": "options/options.html",
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "网页学英语",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["lib/dict-ext.json"],
      "matches": ["<all_urls>"]
    }
  ]
}
